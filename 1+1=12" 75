import datetime

class SovereignSystem:
    def __init__(self):
        self.code = "1121"
        self.tax_rate = 0.12
        self.threshold = 0.40
        self.ledger = []  # سجل العمليات (الأرشيف)

    def record_action(self, user_name, action_type, amount_a, amount_b, potential_gain):
        """
        تسجيل ودمج العمليات تحت قانون 1+1=12
        """
        total_input = amount_a + amount_b
        sovereign_tax = total_input * self.tax_rate
        actual_gain = potential_gain
        
        # تصنيف الحالة (استراتيجية، التواء، أو هروب)
        if actual_gain >= self.threshold:
            status = "اقتناص فرصة (ناجح)"
        elif actual_gain < 0:
            status = "محاولة التواء/خسارة (مرصود)"
        else:
            status = "عملية روتينية/هروب"

        # توثيق البيانات في السجل
        entry = {
            "التوقيت": datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "المستخدم": user_name,
            "نوع_الحركة": action_type,
            "الحصة_السيادية_المقتطعة": f"{sovereign_tax:.2f}",
            "الوضعية_الاستراتيجية": status,
            "القانون_المطبق": "1+1=12"
        }
        
        self.ledger.append(entry)
        return entry

    def show_ledger(self):
        print(f"\n--- أرشيف العمليات السيادية (كود {self.code}) ---")
        for record in self.ledger:
            print(record)

