class SovereignEngine:
    def __init__(self):
        self.code = "1121"
        self.tax_rate = 0.12  # قانون الـ 12%
        self.min_opportunity_threshold = 0.40  # فرص الـ 40% فما فوق
        self.treasury = 0.0

    def process_encounter(self, party_a, party_b, opportunity_yield):
        """
        معالجة التقاء طرفين (1+1) داخل النظام
        """
        total_value = party_a + party_b
        
        # 1. اقتطاع الحصة السيادية (الـ 12%)
        sovereign_cut = total_value * self.tax_rate
        self.treasury += sovereign_cut
        
        # 2. تحليل جودة الفرصة (التي لا يراها أحد)
        is_strategic = opportunity_yield >= self.min_opportunity_threshold
        
        status = "فرصة استراتيجية مكتشفة" if is_strategic else "عملية روتينية"
        
        # 3. النتيجة النهائية للأطراف بعد الضريبة السيادية
        final_distributed_value = (total_value + (total_value * opportunity_yield)) - sovereign_cut
        
        return {
            "قانون_النظام": "1+1=12%",
            "الحصة_السيادية": sovereign_cut,
            "حالة_الفرصة": status,
            "العائد_الصافي_للأطراف": final_distributed_value,
            "الخزينة_المركزية": self.treasury
        }

# --- تشغيل المحرك ---
