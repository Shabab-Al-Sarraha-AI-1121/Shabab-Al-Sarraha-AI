import datetime
import csv
import os
from cryptography.fernet import Fernet

class UltimateSovereignCore:
    def __init__(self):
        self.code = "1121"
        self.tax_rate = 0.12
        self.threshold = 0.40
        self.filename = "Secure_Sovereign_Ledger.crypt"
        
        # إنشاء أو استرجاع مفتاح التشفير (هذا هو سرك الأكبر)
        self.key_file = "sovereign.key"
        if not os.path.exists(self.key_file):
            self.key = Fernet.generate_key()
            with open(self.key_file, "wb") as kf:
                kf.write(self.key)
        else:
            with open(self.key_file, "rb") as kf:
                self.key = kf.read()
        
        self.cipher = Fernet(self.key)
        self.branches = {1: "الرصد الاستراتيجي", 2: "التنفيذ المالي", 3: "الأرشفة والتحكم"}

    def encrypt_data(self, data_string):
        return self.cipher.encrypt(data_string.encode()).decode()

    def decrypt_data(self, encrypted_string):
        return self.cipher.decrypt(encrypted_string.encode()).decode()

    def execute_and_protect(self, branch_id, user_name, amount_a, amount_b, gain_percent):
        """التنفيذ، الاقتطاع، والتشفير الفوري"""
        total_input = amount_a + amount_b
        sovereign_cut = total_input * self.tax_rate
        
        status = "🔥 فرصة استراتيجية" if gain_percent >= self.threshold else "📉 عملية روتينية"
        if gain_percent < 0: status = "⚠️ محاولة التواء"

        timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        branch_name = self.branches.get(branch_id, "فرع مجهول")

        # تجهيز السطر وتشفيره بالكامل
        raw_entry = f"{timestamp}|{branch_name}|{user_name}|{total_input}|{sovereign_cut:.2f}|{status}"
        encrypted_entry = self.encrypt_data(raw_entry)

        with open(self.filename, mode='a', encoding='utf-8') as f:
            f.write(encrypted_entry + "\n")

        return {
            "الوضعية": "تمت العملية وحمايتها بتشفير سيادي",
            "الحصة_المؤمنة": f"{sovereign_cut:.2f} MAD"
        }

    def read_secure_ledger(self):
        """فقط المخطط يمكنه فك تشفير السجل وقراءته"""
        print(f"\n--- فك تشفير سجل السيادة (كود {self.code}) ---")
        if os.path.exists(self.filename):
            with open(self.filename, "r") as f:
                for line in f:
                    print(self.decrypt_data(line.strip()))

# --- التشغيل السري ---
